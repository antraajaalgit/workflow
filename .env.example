APP_NAME=Karya
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nagare
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_FROM_ADDRESS=your-gmail-address@gmail.com
MAIL_FROM_NAME="Karya by Antrajaal"

CHAT_MAIL_SCHEME=smtps
CHAT_MAIL_HOST=smtp.hostinger.com
CHAT_MAIL_PORT=465
CHAT_MAIL_USERNAME=hello@antraajaal.com
CHAT_MAIL_PASSWORD=
CHAT_MAIL_FROM_ADDRESS=hello@antraajaal.com
CHAT_MAIL_FROM_NAME="Karya by Antrajaal"

GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/api/google-calendar/callback

# Required for attendance geofencing. Supply the real office coordinates and limits.
ATTENDANCE_OFFICE_LATITUDE=30.738888
ATTENDANCE_OFFICE_LONGITUDE=76.793798
ATTENDANCE_GEOFENCE_RADIUS_METRES=100
ATTENDANCE_MAX_ACCURACY_METRES=100

ATTENDANCE_OFFICE_IPS=223.178.210.107
ATTENDANCE_OFFICE_HOSTNAMES=karya-office.dedyn.io

# Exact reverse-proxy IPs, comma-separated; empty for direct hosting.
# Proxies must overwrite forwarding headers. Do not list client/office IPs here.
TRUSTED_PROXY_IPS=
